# Environment Variables for Cetas Ecosystem Platform

# Database (PostgreSQL - Local / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cetas_db?schema=public"

# NextAuth / Auth Secret
NEXTAUTH_SECRET="cetas-super-secret-key-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"

# DOKU Direct API & SNAP BI Configuration (QRIS & E-Wallet: OVO, ShopeePay, DANA)
# Dapatkan Client ID & Secret Key dari DOKU Back Office / Portal ASPI: https://apidevportal.aspi-indonesia.or.id
DOKU_CLIENT_ID="MCH-CETAS-YOUR_CLIENT_ID"
DOKU_SECRET_KEY="SK-CETAS-YOUR_SECRET_KEY"
DOKU_IS_PRODUCTION="false"

# QR Code & Ticket Signing Secret Key (HMAC-SHA256)
TICKET_SIGNING_SECRET="cetas-dynamic-qr-ticket-secret-salt-2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
