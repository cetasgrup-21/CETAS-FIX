# Environment Variables for Cetas Ecosystem Platform

# Database (PostgreSQL - Local / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cetas_db?schema=public"

# NextAuth / Auth Secret
NEXTAUTH_SECRET="cetas-super-secret-key-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"

# Xendit Payment Gateway Configuration (QRIS, E-Wallet: OVO, ShopeePay, DANA & Virtual Account)
# Dapatkan Secret Key & Public Key dari Xendit Dashboard: https://dashboard.xendit.co
XENDIT_SECRET_KEY="xnd_development_YOUR_SECRET_KEY"
XENDIT_PUBLIC_KEY="xnd_public_development_YOUR_PUBLIC_KEY"
XENDIT_WEBHOOK_VERIFICATION_TOKEN="YOUR_WEBHOOK_VERIFICATION_TOKEN"
XENDIT_IS_PRODUCTION="false"

# QR Code & Ticket Signing Secret Key (HMAC-SHA256)
TICKET_SIGNING_SECRET="cetas-dynamic-qr-ticket-secret-salt-2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Gateway (Fonnte / Wablas)
FONNTE_TOKEN="YOUR_FONNTE_DEVICE_TOKEN"
WHATSAPP_GATEWAY_URL="https://api.fonnte.com/send"

