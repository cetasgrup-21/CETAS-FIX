generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id          String    @id @default(cuid())
  name        String
  date        DateTime?
  location    String?
  logo        String?
  banner      String?
  status      String    @default("ACTIVE")
  inputMode   String    @default("DIGITAL")
  totalPoints Int       @default(5000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories      Category[]
  participants    Participant[]
  levels          EventLevel[]
  timerGroups     TimerGroup[]
  timerRecords    TimerRecord[]
  awardCategories AwardCategory[]
}

model EventLevel {
  id        String   @id @default(cuid())
  eventId   String
  code      String
  name      String
  sortOrder Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categories      Category[]
  categoryLinks   CategoryLevel[]
  participants    Participant[]
  judgeLinks      LevelJudge[]
  awardCategories AwardCategory[]

  @@unique([eventId, code])
  @@index([eventId, sortOrder])
}

model Category {
  id           String  @id @default(cuid())
  eventId      String
  eventLevelId String?
  name         String
  percentage   Float   @default(0)
  status       String  @default("ACTIVE")
  sortOrder    Int     @default(0)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventLevel EventLevel? @relation(fields: [eventLevelId], references: [id], onDelete: SetNull)

  levelLinks           CategoryLevel[]
  judgeLinks           CategoryJudge[]
  criteria             Criterion[]
  participants         Participant[]
  scores               Score[]
  subCategories        SubCategory[]
  timerGroupCategories TimerGroupCategory[]
  awardCategories      AwardCategory[]
  awardCategorySources AwardCategorySource[]

  @@index([eventId, eventLevelId, sortOrder])
}

model CategoryLevel {
  categoryId String
  levelId    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level    EventLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([categoryId, levelId])
  @@index([levelId, sortOrder])
  @@index([categoryId])
}

model SubCategory {
  id         String @id @default(cuid())
  categoryId String
  name       String
  percentage Float  @default(0)
  sortOrder  Int    @default(0)
  status     String @default("ACTIVE")

  criteria Criterion[]

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
}

model MasterMaterial {
  id        String   @id @default(cuid())
  category  String
  section   String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria Criterion[]

  @@index([category, section])
}

model Criterion {
  id            String  @id @default(cuid())
  categoryId    String
  subCategoryId String?
  materialId    String?
  name          String
  section       String?
  interval      Int?
  sortOrder     Int     @default(0)
  inputType     String  @default("RATING")
  difficulty    String  @default("MUDAH")

  material MasterMaterial? @relation(fields: [materialId], references: [id])

  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  scores  Score[]
  options ScoreOption[]

  @@index([categoryId, subCategoryId, sortOrder])
}

model ScoreOption {
  id          String @id @default(cuid())
  criterionId String
  label       String
  score       Float
  sortOrder   Int    @default(0)

  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  pinHash   String
  role      String   @default("OPERATOR")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs     AuditLog[]
  categoryLinks CategoryJudge[]
  levelLinks    LevelJudge[]
  scores        Score[]
  sessions      Session[]
}

model LevelJudge {
  levelId String
  judgeId String

  level EventLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  judge User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@id([levelId, judgeId])
  @@index([judgeId])
}

model CategoryJudge {
  categoryId String
  judgeId    String

  judge    User     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, judgeId])
  @@index([judgeId])
}

model Participant {
  id           String  @id @default(cuid())
  eventId      String
  categoryId   String?
  eventLevelId String?
  number       Int
  displayOrder Int?
  name         String
  school       String?
  level        String?
  photo        String?
  logo         String?
  status       String  @default("ACTIVE")

  bonuses      Bonus[]
  category     Category?     @relation(fields: [categoryId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventLevel   EventLevel?   @relation(fields: [eventLevelId], references: [id], onDelete: SetNull)
  penalties    Penalty[]
  results      Result?
  scores       Score[]
  timerRecords TimerRecord[]
  awardWins    AwardWinner[]

  @@index([eventId, eventLevelId])
}

model Score {
  id            String    @id @default(cuid())
  participantId String
  criterionId   String
  categoryId    String
  judgeId       String
  score         Float
  label         String?
  note          String?
  status        String    @default("DRAFT")
  submittedAt   DateTime?
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  judge       User        @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  criterion   Criterion   @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, criterionId, judgeId])
}

model Penalty {
  id            String  @id @default(cuid())
  participantId String
  type          String
  amount        Float
  note          String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Bonus {
  id            String  @id @default(cuid())
  participantId String
  type          String
  amount        Float
  note          String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Result {
  id            String   @id @default(cuid())
  participantId String   @unique
  rawScore      Float    @default(0)
  bonus         Float    @default(0)
  penalty       Float    @default(0)
  finalScore    Float    @default(0)
  rank          Int?
  status        String   @default("ACTIVE")
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String
  targetId   String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TimerGroup {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  sortOrder Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categories TimerGroupCategory[]
  records    TimerRecord[]

  @@index([eventId, sortOrder])
}

model TimerGroupCategory {
  groupId    String
  categoryId String
  sortOrder  Int    @default(0)

  group    TimerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([groupId, categoryId])
  @@index([categoryId])
}

model TimerRecord {
  id            String    @id @default(cuid())
  eventId       String
  participantId String
  timerGroupId  String?
  mode          String    @default("PARTICIPANT")
  runKey        String    @unique
  startedAt     DateTime?
  stoppedAt     DateTime?
  durationSec   Int?
  status        String    @default("READY")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  timerGroup  TimerGroup? @relation(fields: [timerGroupId], references: [id], onDelete: SetNull)

  @@index([eventId, participantId])
  @@index([eventId, timerGroupId])
  @@index([participantId, timerGroupId])
}

model AwardCategory {
  id               String    @id @default(cuid())
  eventId          String
  eventLevelId     String?
  sourceCategoryId String?
  name             String
  method           String    @default("RANKING")
  rankPosition     Int?
  sortOrder        Int       @default(0)
  status           String    @default("DRAFT")
  tieBreakers      String?
  lockedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventLevel     EventLevel?   @relation(fields: [eventLevelId], references: [id], onDelete: SetNull)
  sourceCategory Category?     @relation(fields: [sourceCategoryId], references: [id], onDelete: SetNull)
  winners        AwardWinner[]
  categorySources AwardCategorySource[]

  @@index([eventId, eventLevelId, sortOrder])
  @@index([sourceCategoryId])
}

model AwardCategorySource {
  id              String   @id @default(cuid())
  awardCategoryId String
  categoryId      String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  awardCategory AwardCategory @relation(fields: [awardCategoryId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([awardCategoryId, categoryId])
  @@index([categoryId])
}

model AwardWinner {
  id              String   @id @default(cuid())
  awardCategoryId String
  participantId   String
  winnerOrder     Int      @default(1)
  source          String   @default("MANUAL")
  score           Float?
  note            String?
  createdAt       DateTime @default(now())

  awardCategory AwardCategory @relation(fields: [awardCategoryId], references: [id], onDelete: Cascade)
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([awardCategoryId, participantId])
  @@index([participantId])
}
