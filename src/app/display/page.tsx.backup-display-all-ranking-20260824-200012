"use client";

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";

type Level = {
  id: string;
  code: string;
  name: string;
  sortOrder: number;
};

type CategoryResult = {
  categoryId: string;
  categoryName: string;
  percentage: number;
  maximum: number;
  score: number;
  complete: boolean;
  scored: number;
  expected: number;
  judgeCount: number;
};

type Participant = {
  id: string;
  number: number;
  name: string;
  school: string | null;
  level: string | null;
  eventLevelId: string | null;
};

type Row = {
  participant: Participant;
  categories: CategoryResult[];
  finalScore: number;
  rawScore: number;
  bonus: number;
  penalty: number;
  complete: boolean;
  rank: number | null;
};

type ApiResponse = {
  success: boolean;
  error?: string;

  event?: {
    id: string;
    name: string;
    totalPoints: number;
  };

  levels?: Level[];

  rows?: Row[];
};

const formatNumber = (value: unknown) =>
  Number(value || 0).toLocaleString("id-ID");

export default function DisplayPage() {
  const [data, setData] =
    useState<ApiResponse | null>(null);

  const [levelId, setLevelId] =
    useState("");

  const [categoryId, setCategoryId] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const [error, setError] =
    useState("");

  const [lastUpdated, setLastUpdated] =
    useState<Date | null>(null);

  const [fullscreen, setFullscreen] =
    useState(false);

  /*
   * =========================================================
   * LOAD DATA
   * =========================================================
   */

  const loadData = useCallback(
    async (silent = false) => {
      try {
        if (silent) {
          setRefreshing(true);
        } else {
          setLoading(true);
        }

        setError("");

        const query = levelId
          ? `?eventLevelId=${encodeURIComponent(
              levelId
            )}`
          : "";

        const response = await fetch(
          `/api/rekap${query}`,
          {
            cache: "no-store",
          }
        );

        const result =
          (await response.json()) as ApiResponse;

        if (
          !response.ok ||
          !result.success
        ) {
          throw new Error(
            result.error ||
              "Gagal mengambil data hasil."
          );
        }

        setData(result);
        setLastUpdated(new Date());
      } catch (err) {
        console.error(
          "DISPLAY LOAD ERROR:",
          err
        );

        if (!silent) {
          setError(
            err instanceof Error
              ? err.message
              : "Gagal mengambil data hasil."
          );
        }
      } finally {
        if (silent) {
          setRefreshing(false);
        } else {
          setLoading(false);
        }
      }
    },
    [levelId]
  );

  /*
   * =========================================================
   * INITIAL LOAD + AUTO REFRESH
   * =========================================================
   */

  useEffect(() => {
    void loadData(false);

    const interval =
      window.setInterval(() => {
        void loadData(true);
      }, 5000);

    return () => {
      window.clearInterval(interval);
    };
  }, [loadData]);

  /*
   * =========================================================
   * FULLSCREEN STATE
   * =========================================================
   */

  useEffect(() => {
    const handleFullscreen = () => {
      setFullscreen(
        Boolean(document.fullscreenElement)
      );
    };

    document.addEventListener(
      "fullscreenchange",
      handleFullscreen
    );

    return () => {
      document.removeEventListener(
        "fullscreenchange",
        handleFullscreen
      );
    };
  }, []);

  /*
   * =========================================================
   * FULLSCREEN
   * =========================================================
   */

  const toggleFullscreen = async () => {
    try {
      if (!document.fullscreenElement) {
        await document.documentElement.requestFullscreen();
      } else {
        await document.exitFullscreen();
      }
    } catch (err) {
      console.error(
        "FULLSCREEN ERROR:",
        err
      );
    }
  };

  /*
   * =========================================================
   * LEVEL
   * =========================================================
   */

  const levels = useMemo(() => {
    return [...(data?.levels || [])].sort(
      (a, b) =>
        a.sortOrder - b.sortOrder
    );
  }, [data]);

  /*
   * =========================================================
   * KATEGORI PENILAIAN
   *
   * Diambil langsung dari categories milik
   * peserta yang dikirim API Rekap.
   *
   * Jadi kategori otomatis mengikuti konfigurasi
   * penilaian event.
   * =========================================================
   */

  const categories = useMemo(() => {
    const map =
      new Map<string, CategoryResult>();

    for (const row of data?.rows || []) {
      for (const category of
        row.categories || []) {
        if (
          !map.has(category.categoryId)
        ) {
          map.set(
            category.categoryId,
            category
          );
        }
      }
    }

    return Array.from(
      map.values()
    );
  }, [data]);

  /*
   * =========================================================
   * VALIDASI CATEGORY SAAT LEVEL BERUBAH
   *
   * Kalau kategori yang sebelumnya dipilih
   * tidak tersedia pada tingkatan baru,
   * otomatis kembali ke Semua Kategori.
   * =========================================================
   */

  useEffect(() => {
    if (!categoryId) return;

    const exists = categories.some(
      (category) =>
        category.categoryId ===
        categoryId
    );

    if (!exists) {
      setCategoryId("");
    }
  }, [categories, categoryId]);

  /*
   * =========================================================
   * SELECTED CATEGORY
   * =========================================================
   */

  const selectedCategory =
    useMemo(() => {
      return categories.find(
        (category) =>
          category.categoryId ===
          categoryId
      );
    }, [
      categories,
      categoryId,
    ]);

  /*
   * =========================================================
   * LEADERBOARD
   *
   * TANPA kategori:
   * -> gunakan ranking final keseluruhan
   *
   * DENGAN kategori:
   * -> ranking berdasarkan score kategori tersebut
   * =========================================================
   */

  const rows = useMemo(() => {
    const source =
      data?.rows || [];

    /*
     * ================================
     * RANKING KESELURUHAN
     * ================================
     */

    if (!categoryId) {
      return source
        .filter(
          (row) => row.complete
        )
        .sort((a, b) => {
          const rankA =
            a.rank ?? 999999;

          const rankB =
            b.rank ?? 999999;

          if (rankA !== rankB) {
            return (
              rankA - rankB
            );
          }

          return (
            a.participant.number -
            b.participant.number
          );
        })
        .map((row, index) => ({
          ...row,
          displayScore:
            row.finalScore,
          displayRank:
            index + 1,
        }));
    }

    /*
     * ================================
     * RANKING BERDASARKAN KATEGORI
     * ================================
     */

    return source
      .map((row) => {
        const category =
          row.categories?.find(
            (item) =>
              item.categoryId ===
              categoryId
          );

        if (!category) {
          return null;
        }

        if (!category.complete) {
          return null;
        }

        return {
          ...row,
          selectedCategory: category,
          displayScore:
            category.score,
          displayRank:
            null as number | null,
        };
      })
      .filter(
        (
          row
        ): row is NonNullable<
          typeof row
        > => row !== null
      )
      .sort((a, b) => {
        if (
          b.displayScore !==
          a.displayScore
        ) {
          return (
            b.displayScore -
            a.displayScore
          );
        }

        return (
          a.participant.number -
          b.participant.number
        );
      })
      .map((row, index) => ({
        ...row,
        displayRank:
          index + 1,
      }));
  }, [
    data,
    categoryId,
  ]);

  /*
   * =========================================================
   * TOP 3
   * =========================================================
   */

  const topThree =
    rows.slice(0, 3);

  /*
   * =========================================================
   * RANKING 4 - 10
   * =========================================================
   */

  const remainingRows =
    rows.slice(3, 10);

  /*
   * =========================================================
   * LABEL DISPLAY
   * =========================================================
   */

  const resultTitle =
    selectedCategory
      ? selectedCategory.categoryName
      : "HASIL KESELURUHAN";

  return (
    <main className="min-h-screen bg-[#071a3d] text-white">
      <div className="min-h-screen px-5 py-6 md:px-10 md:py-8">

        <div className="mx-auto max-w-[1600px]">

          {/* =================================================
              HEADER
          ================================================= */}

          <header className="mb-6 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">

            <div>
              <p className="text-xs font-black tracking-[0.35em] text-blue-300">
                CETAS SCORE
              </p>

              <h1 className="mt-2 text-3xl font-black tracking-tight md:text-5xl">
                LIVE RESULTS
              </h1>

              <p className="mt-2 text-sm font-semibold text-white/60 md:text-base">
                {data?.event?.name ||
                  "Memuat event..."}
              </p>

              {selectedCategory && (
                <div className="mt-2">
                  <span className="inline-flex rounded-full border border-blue-400/20 bg-blue-400/10 px-3 py-1 text-xs font-black uppercase tracking-wider text-blue-300">
                    {selectedCategory.categoryName}
                  </span>
                </div>
              )}
            </div>

            {/* =================================================
                FILTER AREA
            ================================================= */}

            <div className="flex flex-wrap items-center gap-2">

              {/* ===============================
                  FILTER TINGKATAN
              =============================== */}

              <select
                value={levelId}
                onChange={(event) => {
                  setLevelId(
                    event.target.value
                  );

                  /*
                   * Saat tingkatan berubah,
                   * kategori akan divalidasi
                   * berdasarkan kategori baru.
                   */
                }}
                className="min-w-[220px] rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-bold text-white outline-none backdrop-blur transition focus:border-blue-400/50"
              >
                <option
                  value=""
                  className="text-slate-900"
                >
                  Semua Tingkatan
                </option>

                {levels.map(
                  (level) => (
                    <option
                      key={level.id}
                      value={level.id}
                      className="text-slate-900"
                    >
                      {level.name}
                    </option>
                  )
                )}
              </select>

              {/* ===============================
                  FILTER KATEGORI
              =============================== */}

              <select
                value={categoryId}
                onChange={(event) =>
                  setCategoryId(
                    event.target.value
                  )
                }
                disabled={
                  categories.length === 0
                }
                className="min-w-[220px] rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-bold text-white outline-none backdrop-blur transition focus:border-blue-400/50 disabled:cursor-not-allowed disabled:opacity-40"
              >
                <option
                  value=""
                  className="text-slate-900"
                >
                  Semua Kategori
                </option>

                {categories.map(
                  (category) => (
                    <option
                      key={
                        category.categoryId
                      }
                      value={
                        category.categoryId
                      }
                      className="text-slate-900"
                    >
                      {category.categoryName}
                    </option>
                  )
                )}
              </select>

              {/* ===============================
                  FULLSCREEN
              =============================== */}

              <button
                type="button"
                onClick={() =>
                  void toggleFullscreen()
                }
                className="rounded-xl bg-blue-600 px-5 py-3 text-sm font-black transition hover:bg-blue-500"
              >
                {fullscreen
                  ? "Keluar Fullscreen"
                  : "Fullscreen"}
              </button>
            </div>
          </header>

          {/* =================================================
              ERROR
          ================================================= */}

          {error && (
            <div className="mb-6 rounded-2xl border border-red-400/30 bg-red-500/10 px-5 py-4 text-sm font-bold text-red-200">
              {error}
            </div>
          )}

          {/* =================================================
              LOADING
          ================================================= */}

          {loading ? (
            <section className="flex min-h-[60vh] items-center justify-center">
              <div className="text-center">

                <div className="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-white/20 border-t-blue-400" />

                <p className="mt-4 text-sm font-bold text-white/60">
                  Memuat hasil...
                </p>

              </div>
            </section>
          ) : rows.length === 0 ? (

            /* =================================================
               EMPTY STATE
            ================================================= */

            <section className="flex min-h-[60vh] items-center justify-center">
              <div className="rounded-3xl border border-white/10 bg-white/5 px-8 py-12 text-center">

                <p className="text-2xl font-black">
                  BELUM ADA HASIL LENGKAP
                </p>

                <p className="mt-2 text-sm text-white/50">
                  {selectedCategory
                    ? `Belum ada peserta dengan penilaian lengkap pada kategori ${selectedCategory.categoryName}.`
                    : "Hasil akan muncul setelah penilaian peserta selesai."}
                </p>

              </div>
            </section>

          ) : (

            <>
              {/* =================================================
                  RESULT MODE
              ================================================= */}

              <div className="mb-4 flex items-center justify-between">

                <div>
                  <p className="text-xs font-black tracking-[0.25em] text-white/30">
                    {categoryId
                      ? "RANKING KATEGORI"
                      : "RANKING KESELURUHAN"}
                  </p>

                  <p className="mt-1 text-lg font-black text-white/80">
                    {resultTitle}
                  </p>
                </div>

                {selectedCategory && (
                  <div className="hidden text-right md:block">
                    <p className="text-[10px] font-black tracking-wider text-white/30">
                      BOBOT
                    </p>

                    <p className="text-lg font-black text-blue-300">
                      {formatNumber(
                        selectedCategory.percentage
                      )}
                      %
                    </p>
                  </div>
                )}
              </div>

              {/* =================================================
                  TOP 3
              ================================================= */}

              <section className="grid gap-4 md:grid-cols-3">

                {topThree.map(
                  (row, index) => {

                    const position =
                      row.displayRank ??
                      index + 1;

                    const isFirst =
                      position === 1;

                    return (
                      <div
                        key={
                          row.participant
                            .id
                        }
                        className={[
                          "relative overflow-hidden rounded-3xl border p-6 shadow-2xl",
                          isFirst
                            ? "border-yellow-300/40 bg-gradient-to-br from-yellow-300/20 to-white/5 md:-translate-y-3"
                            : "border-white/10 bg-white/5",
                        ].join(" ")}
                      >

                        {/* RANK + NUMBER */}

                        <div className="flex items-start justify-between gap-4">

                          <div>
                            <p className="text-xs font-black tracking-[0.25em] text-white/40">
                              PERINGKAT
                            </p>

                            <p className="mt-1 text-6xl font-black">
                              {position}
                            </p>
                          </div>

                          <div className="rounded-2xl bg-white/10 px-4 py-3 text-right">

                            <p className="text-[10px] font-black tracking-wider text-white/40">
                              NO
                            </p>

                            <p className="text-2xl font-black">
                              {
                                row
                                  .participant
                                  .number
                              }
                            </p>

                          </div>

                        </div>

                        {/* PESERTA */}

                        <div className="mt-6">

                          <p className="truncate text-xl font-black md:text-2xl">
                            {
                              row
                                .participant
                                .name
                            }
                          </p>

                          <p className="mt-1 truncate text-sm font-semibold text-white/50">
                            {
                              row
                                .participant
                                .school ||
                              "-"
                            }
                          </p>

                        </div>

                        {/* SCORE */}

                        <div className="mt-6 border-t border-white/10 pt-5">

                          <p className="text-xs font-black tracking-wider text-white/40">
                            {selectedCategory
                              ? "NILAI KATEGORI"
                              : "TOTAL NILAI"}
                          </p>

                          <p className="mt-1 text-4xl font-black text-blue-300">
                            {formatNumber(
                              row.displayScore
                            )}
                          </p>

                        </div>

                      </div>
                    );
                  }
                )}

              </section>

              {/* =================================================
                  RANKING 4 - 10
              ================================================= */}

              {remainingRows.length >
                0 && (
                <section className="mt-6 overflow-hidden rounded-3xl border border-white/10 bg-white/5">

                  <div className="grid grid-cols-[90px_100px_1fr_220px] gap-4 border-b border-white/10 bg-white/5 px-5 py-4 text-xs font-black tracking-wider text-white/40">

                    <div>
                      RANK
                    </div>

                    <div>
                      NO
                    </div>

                    <div>
                      PESERTA
                    </div>

                    <div className="text-right">
                      {selectedCategory
                        ? "NILAI KATEGORI"
                        : "NILAI"}
                    </div>

                  </div>

                  <div>

                    {remainingRows.map(
                      (row) => (
                        <div
                          key={
                            row
                              .participant
                              .id
                          }
                          className="grid grid-cols-[90px_100px_1fr_220px] items-center gap-4 border-b border-white/5 px-5 py-4 last:border-b-0"
                        >

                          <div className="text-2xl font-black text-white/60">
                            {
                              row.displayRank
                            }
                          </div>

                          <div className="text-lg font-black">
                            {
                              row
                                .participant
                                .number
                            }
                          </div>

                          <div className="min-w-0">

                            <p className="truncate text-lg font-black">
                              {
                                row
                                  .participant
                                  .name
                              }
                            </p>

                            <p className="truncate text-sm text-white/40">
                              {
                                row
                                  .participant
                                  .school ||
                                "-"
                              }
                            </p>

                          </div>

                          <div className="text-right text-2xl font-black text-blue-300">
                            {formatNumber(
                              row.displayScore
                            )}
                          </div>

                        </div>
                      )
                    )}

                  </div>

                </section>
              )}

              {/* =================================================
                  FOOTER
              ================================================= */}

              <footer className="mt-6 flex flex-col gap-2 text-xs font-semibold text-white/30 md:flex-row md:items-center md:justify-between">

                <span>
                  MENAMPILKAN{" "}
                  {rows.length}{" "}
                  PESERTA DENGAN NILAI LENGKAP
                </span>

                <span>
                  {refreshing
                    ? "Memperbarui..."
                    : lastUpdated
                      ? `Update terakhir ${lastUpdated.toLocaleTimeString(
                          "id-ID"
                        )}`
                      : "Menunggu update"}
                </span>

              </footer>

            </>
          )}
        </div>
      </div>
    </main>
  );
}