        {showParticipantPicker ? (
          <div
            className="fixed inset-0 z-50 flex items-end justify-center bg-[#071a3d]/60 p-0 backdrop-blur-sm sm:items-center sm:p-4"
            role="dialog"
            aria-modal="true"
          >
            <div className="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-3xl bg-white shadow-2xl sm:max-w-lg sm:rounded-3xl">

              <div className="border-b border-slate-200 p-5 md:p-6">
                <div className="flex items-start justify-between gap-4">
                  <div>
                    <p className="text-[10px] font-black uppercase tracking-[.18em] text-blue-600">
                      Navigasi Peserta
                    </p>
                    <h2 className="mt-1 text-xl font-black text-[#071a3d]">
                      Pindah Peserta
                    </h2>
                    <p className="mt-1 text-sm text-slate-500">
                      Pilih pasukan yang ingin Anda nilai. Nilai yang sudah tersimpan tetap aman.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => setShowParticipantPicker(false)}
                    className="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-100 text-lg font-black text-slate-500 transition hover:bg-slate-200"
                    aria-label="Tutup"
                  >
                    ×
                  </button>
                </div>
              </div>

              <div className="min-h-0 flex-1 space-y-2 overflow-y-auto overscroll-contain p-3 sm:max-h-[60vh] sm:p-4">
                {participants.map((participant, index) => {
                  const active = index === participantIndex;

                  return (
                    <button
                      key={participant.id}
                      type="button"
                      onClick={() => selectParticipant(index)}
                      disabled={participantActionLoading}
                      className={`flex w-full items-center gap-3 rounded-2xl border p-3 text-left transition ${
                        active
                          ? "border-blue-200 bg-blue-50"
                          : "border-slate-200 bg-white hover:border-blue-200 hover:bg-slate-50"
                      }`}
                    >
                      <div className={`grid h-11 w-11 shrink-0 place-items-center rounded-xl text-sm font-black ${
                        active
                          ? "bg-[#1769e0] text-white"
                          : "bg-[#071a3d] text-white"
                      }`}>
                        {participant.number}
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-black text-[#071a3d]">
                          {participant.name}
                        </p>
                        <p className="truncate text-xs font-medium text-slate-400">
                          {participant.school || "-"}
                        </p>
                      </div>

                      <div className="shrink-0 text-right">
                        <p className="text-[10px] font-black uppercase tracking-wider text-slate-400">
                          Peserta
                        </p>
                        <p className="text-xs font-black text-[#071a3d]">
                          {index + 1} / {participants.length}
                        </p>
                        {active ? (
                          <span className="mt-1 inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] font-black uppercase text-emerald-700">
                            Aktif
                          </span>
                        ) : null}
                      </div>
                    </button>
                  );
                })}
              </div>

              <div className="flex justify-end border-t border-slate-200 bg-slate-50 p-4">
                <button
                  type="button"
                  onClick={() => setShowParticipantPicker(false)}
                  className="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-black text-slate-600 hover:bg-slate-100"
                >
                  Batal
                </button>
              </div>

            </div>
          </div>
        ) : null}

        {/* =================================================
            CRITERION PICKER MODAL
        ================================================= */}

        {showCriterionPicker ? (
          <div
            className="fixed inset-0 z-[55] flex items-end justify-center bg-[#071a3d]/60 p-0 backdrop-blur-sm sm:items-center sm:p-4"
            role="dialog"
            aria-modal="true"
          >
            <div className="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-3xl bg-white shadow-2xl sm:max-w-2xl sm:rounded-3xl">

              {/* HEADER */}
              <div className="shrink-0 border-b border-slate-200 p-4 sm:p-6">
                <div className="flex items-start justify-between gap-3">
                  <div className="min-w-0">
                    <p className="text-[9px] font-black uppercase tracking-[.18em] text-blue-600 sm:text-[10px]">
                      Navigasi Materi
                    </p>
                    <h2 className="mt-1 text-lg font-black text-[#071a3d] sm:text-xl">
                      Pindah Materi
                    </h2>
                    <p className="mt-1 text-xs leading-5 text-slate-500 sm:text-sm">
                      Pilih materi yang ingin dibuka. Nilai yang sudah tersimpan tetap aman.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => setShowCriterionPicker(false)}
                    className="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-100 text-lg font-black text-slate-500 transition hover:bg-slate-200"
                    aria-label="Tutup"
                  >
                    ×
                  </button>
                </div>
              </div>

              {/* LIST */}
              <div className="min-h-0 flex-1 space-y-2 overflow-y-auto overscroll-contain p-3 sm:p-4">
                {allCriteria.map((criterion, index) => {
                  const key = currentParticipant
                    ? `${currentParticipant.id}:${criterion.id}`
                    : "";

                  const savedValue = key
                    ? selectedValues[key]
                    : undefined;

                  const active = index === criterionIndex;
                  const completed = Boolean(savedValue);

                  return (
                    <button
                      key={criterion.id}
                      type="button"
                      onClick={() => selectCriterion(index)}
                      disabled={participantActionLoading || saving}
                      className={[
                        "flex min-h-[64px] w-full items-center gap-3 rounded-2xl border p-3 text-left transition active:scale-[0.99]",
                        active
                          ? "border-blue-200 bg-blue-50"
                          : "border-slate-200 bg-white hover:border-blue-200 hover:bg-slate-50",
                      ].join(" ")}
                    >
                      <div
                        className={[
                          "grid h-10 w-10 shrink-0 place-items-center rounded-xl text-xs font-black sm:h-11 sm:w-11 sm:text-sm",
                          active
                            ? "bg-[#1769e0] text-white"
                            : "bg-[#071a3d] text-white",
                        ].join(" ")}
                      >
                        {index + 1}
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="break-words text-xs font-black leading-5 text-[#071a3d] sm:text-sm">
                          {criterion.name}
                        </p>
                        {criterion.section ? (
                          <p className="mt-0.5 truncate text-[10px] font-medium text-slate-400 sm:text-xs">
                            {criterion.section}
                          </p>
                        ) : null}
                      </div>

                      <div className="shrink-0 text-right">
                        {active ? (
                          <span className="inline-flex rounded-full bg-blue-100 px-2 py-1 text-[8px] font-black uppercase text-blue-700 sm:text-[9px]">
                            Aktif
                          </span>
                        ) : completed ? (
                          <span className="inline-flex rounded-full bg-emerald-50 px-2 py-1 text-[8px] font-black uppercase text-emerald-700 sm:text-[9px]">
                            âœ“ Dinilai
                          </span>
                        ) : (
                          <span className="inline-flex rounded-full bg-slate-100 px-2 py-1 text-[8px] font-black uppercase text-slate-500 sm:text-[9px]">
                            Belum
                          </span>
                        )}

                        {completed && !active && savedValue ? (
                          <p className="mt-1 text-[10px] font-black text-[#071a3d] sm:text-xs">
                            {formatNumber(savedValue.score)}
                          </p>
                        ) : null}
                      </div>
                    </button>
                  );
                })}
              </div>

              {/* FOOTER */}
              <div className="shrink-0 border-t border-slate-200 bg-slate-50 p-3 sm:p-4">
                <button
                  type="button"
                  onClick={() => setShowCriterionPicker(false)}
                  className="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-black text-slate-600 hover:bg-slate-100 sm:w-auto"
                >
                  Batal
                </button>
              </div>

            </div>
          </div>
        ) : null}

        {/* =================================================
            WITHDRAW CONFIRMATION MODAL
        ================================================= */}

        {showWithdrawConfirm && currentParticipant ? (
          <div
            className="fixed inset-0 z-[60] flex items-end justify-center bg-[#071a3d]/65 p-0 backdrop-blur-sm sm:items-center sm:p-4"
            role="dialog"
            aria-modal="true"
          >
            <div className="max-h-[92vh] w-full overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:max-w-md sm:rounded-3xl">

              <div className="border-b border-red-100 bg-red-50 p-5">
                <p className="text-[10px] font-black uppercase tracking-[.18em] text-red-500">
                  Perubahan Status Peserta
                </p>
                <h2 className="mt-1 text-xl font-black text-[#071a3d]">
                  Tandai Mengundurkan Diri?
                </h2>
              </div>

              <div className="p-5">
                <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                    Peserta
                  </p>
                  <p className="mt-1 text-lg font-black text-[#071a3d]">
                    {currentParticipant.name}
                  </p>
                  <p className="mt-1 text-sm text-slate-500">
                    Nomor {currentParticipant.number} · {currentParticipant.school || "-"}
                  </p>
                </div>

                <div className="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-800">
                  Data peserta dan nilai yang sudah tersimpan <b>tidak dihapus</b>. Peserta hanya dikeluarkan dari daftar penilaian aktif dan tidak akan masuk proses penilaian berikutnya.
                </div>

                <label className="mt-5 block">
                  <span className="mb-2 block text-xs font-black uppercase tracking-wider text-slate-400">
                    Alasan â€” opsional
                  </span>
                  <textarea
                    value={withdrawReason}
                    onChange={(event) => setWithdrawReason(event.target.value)}
                    rows={3}
                    className="w-full resize-none rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 outline-none transition focus:border-red-300 focus:ring-4 focus:ring-red-50"
                    placeholder="Contoh: Pasukan menyatakan mengundurkan diri kepada panitia..."
                    disabled={participantActionLoading}
                  />
                </label>
              </div>

              <div className="flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50 p-4 sm:flex-row sm:justify-end">
                <button
                  type="button"
                  onClick={() => setShowWithdrawConfirm(false)}
                  disabled={participantActionLoading}
                  className="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-600 hover:bg-slate-100 disabled:opacity-50"
                >
                  Batal
                </button>

                <button
                  type="button"
                  onClick={withdrawCurrentParticipant}
                  disabled={participantActionLoading}
                  className="rounded-xl bg-red-600 px-5 py-3 text-sm font-black text-white hover:bg-red-700 disabled:cursor-wait disabled:opacity-60"
                >
                  {participantActionLoading
                    ? "Memproses..."
                    : "Ya, Mengundurkan Diri"}
                </button>
              </div>

            </div>
          </div>
        ) : null}

      </div>
    </main>
  );
}

/*
 * =========================================================
 * PROGRESS BOX
 * =========================================================
 */

function ProgressBox({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="rounded-2xl bg-white/5 px-4 py-3">

      <p className="text-[9px] font-black uppercase tracking-widest text-white/40">
        {label}
      </p>

      <p className="mt-1 text-lg font-black text-white">
        {value}
      </p>

    </div>
  );
}



