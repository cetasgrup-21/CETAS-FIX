  return (
    <div className="flex min-w-0 flex-col">
      {/* JUDUL */}
      <div className="mb-3 text-center">
        <h4 className="text-sm font-black uppercase text-[#071a3d] md:text-base">
          {title}
        </h4>
      </div>

      {/* OPTIONS */}
      <div className="flex flex-col gap-3">
        {options.map((option) => {
          const judgeScore =
            getJudgeScore(Number(option.score));

          const isSelected =
            currentValue?.score ===
            judgeScore;

          return (
            <button
              key={option.id}
              type="button"
              disabled={saving}
              onClick={() =>
                onSelect(option)
              }
              className={[
                "relative flex min-h-[56px] w-full items-center justify-center rounded-xl border-2 px-4 transition-all",
                "active:scale-[0.97]",
                "disabled:cursor-not-allowed disabled:opacity-50",

                isSelected
                  ? "border-[#1769e0] bg-[#1769e0] text-white shadow-md shadow-blue-100"
                  : "border-slate-300 bg-white text-[#071a3d] hover:border-[#1769e0] hover:bg-blue-50",
              ].join(" ")}
            >
              <span
                className={[
                  "text-xl font-black md:text-2xl",
                  isSelected
                    ? "text-white"
                    : "text-[#071a3d]",
                ].join(" ")}
              >
                {formatNumber(judgeScore)}
              </span>

              {option.label ? (
                <span
                  className={[
                    "absolute bottom-1 left-0 right-0 truncate px-2 text-[8px] font-bold uppercase",
                    isSelected
                      ? "text-white/70"
                      : "text-slate-400",
                  ].join(" ")}
                >
                  {option.label}
                </span>
              ) : null}

              {isSelected ? (
                <span className="absolute right-2 top-2 grid h-5 w-5 place-items-center rounded-full bg-white text-[10px] font-black text-[#1769e0]">
                  âœ“
                </span>
              ) : null}
            </button>
          );
        })}

        {options.length === 0 ? (
          <div className="rounded-xl border border-dashed border-slate-200 px-3 py-5 text-center text-xs font-bold text-slate-300">
            -
          </div>
        ) : null}
      </div>
    </div>
  );
}

/*
 * =========================================================
 * PAGE
 * =========================================================
 */

export default function JudgeCategoryPage() {
  const params =
    useParams();

  const router =
    useRouter();

  const categoryId =
    String(
      params.categoryId || ""
    );

  /*
   * =======================================================
   * JUDGE WORKFLOW
   * =======================================================
   *
   * Satu peserta harus menyelesaikan seluruh kategori yang
   * ditugaskan pada tingkatan yang sedang dibuka.
   * Urutan: kategori -> materi -> kategori berikutnya ->
   * review -> submit -> peserta berikutnya.
   */
  const [workflowCategories, setWorkflowCategories] =
    useState<Category[]>([]);

  const [workflowIndex, setWorkflowIndex] =
    useState(0);

  const [categoryDataMap, setCategoryDataMap] =
    useState<Record<string, MainData>>({});

  const activeCategoryId =
    workflowCategories[workflowIndex]?.id || categoryId;

  /*
   * =======================================================
   * MAIN DATA
   * =======================================================
   */

  const [
    data,
    setData,
  ] =
    useState<MainData | null>(
      null
    );

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    error,
    setError,
  ] =
    useState("");

  /*
   * =======================================================
   * PARTICIPANTS
   * =======================================================
   */

  const [
    participants,
    setParticipants,
  ] =
    useState<Participant[]>(
      []
    );

  const [
    participantsLoading,
    setParticipantsLoading,
  ] =
    useState(false);

  /*
   * =======================================================
   * CURRENT PARTICIPANT
   * =======================================================
   */

  const [
    participantIndex,
    setParticipantIndex,
  ] =
    useState(0);

  const [
    positionInitialized,
    setPositionInitialized,
  ] =
    useState(false);

  /*
   * =======================================================
   * CURRENT CRITERION
   * =======================================================
   */

  const [
    criterionIndex,
    setCriterionIndex,
  ] =
    useState(0);

  /*
   * =======================================================
   * SELECTED VALUES
   * =======================================================
   *
   * Key:
   *
   * participantId:criterionId
   */

  const [
    selectedValues,
    setSelectedValues,
  ] =
    useState<
      Record<
        string,
        {
          score: number;
          label: string;
          note: string;
        }
      >
    >({});

  /*
   * =======================================================
   * SAVING
   * =======================================================
   */

  const [
    saving,
    setSaving,
  ] =
    useState(false);

  /*
   * =======================================================
   * SUCCESS
   * =======================================================
   */

  const [
    successMessage,
    setSuccessMessage,
  ] =
    useState("");

  /*
   * =======================================================
   * PARTICIPANT CONTROL
   * =======================================================
   */

  const [showParticipantPicker, setShowParticipantPicker] =
    useState(false);

  const [showCriterionPicker, setShowCriterionPicker] =
    useState(false);

  const [showWithdrawConfirm, setShowWithdrawConfirm] =
    useState(false);

  const [participantActionLoading, setParticipantActionLoading] =
    useState(false);

  const [withdrawReason, setWithdrawReason] =
    useState("");

  const [showReview, setShowReview] =
    useState(false);

  /*
   * =======================================================
   * REQUEST PERUBAHAN NILAI
   * =======================================================
   */

  const [showChangeRequest, setShowChangeRequest] =
    useState(false);

  const [changeReason, setChangeReason] =
    useState("");

  const [changeRequestLoading, setChangeRequestLoading] =
    useState(false);

  const [changeRequestPending, setChangeRequestPending] =
    useState(false);

  const [submitting, setSubmitting] =
    useState(false);

  /*
   * =======================================================
   * LOAD MAIN DATA
   * =======================================================
   */

  async function loadMainData(targetCategoryId = activeCategoryId) {
    try {
      setLoading(true);
      setError("");

      const response =
        await fetch(
          `/api/judge/category/${encodeURIComponent(
            targetCategoryId
          )}`,
          {
            method: "GET",
            cache: "no-store",
            headers: {
              "Cache-Control":
                "no-cache",
            },
          }
        );

      const result =
        await response.json();

      if (!response.ok) {
        throw new Error(
          result.error ||
            "Gagal mengambil data penilaian."
        );
      }

      /*
       * =====================================================
       * LOAD SCORE OPTIONS
       * =====================================================
       */

      let enrichedResult =
        result;

      try {
        const criteriaResponse =
          await fetch(
            `/api/criteria?categoryId=${encodeURIComponent(
              targetCategoryId
            )}`,
            {
              method: "GET",
              cache: "no-store",
              headers: {
                "Cache-Control":
                  "no-cache",
              },
            }
          );

        const criteriaResult =
          await criteriaResponse.json();

        if (
          criteriaResponse.ok &&
          Array.isArray(
            criteriaResult?.criteria
          )
        ) {
          const optionMap =
            new Map<
              string,
              Option[]
            >();

          criteriaResult.criteria.forEach(
            (
              criterion: Criterion
            ) => {
              optionMap.set(
                criterion.id,
                Array.isArray(
                  criterion.options
                )
                  ? criterion.options
                  : []
              );
            }
          );

          const mergeOptions = (
            criterion: Criterion
          ): Criterion => {
            const options =
              optionMap.get(
                criterion.id
              );

            return {
              ...criterion,
              options:
                options ??
                (Array.isArray(
                  criterion.options
                )
                  ? criterion.options
                  : []),
            };
          };

          enrichedResult = {
            ...result,

            criteria:
              Array.isArray(
                result.criteria
              )
                ? result.criteria.map(
                    mergeOptions
                  )
                : [],

            subCategories:
              Array.isArray(
                result.subCategories
              )
                ? result.subCategories.map(
                    (
                      subCategory: SubCategory
                    ) => ({
                      ...subCategory,

                      criteria:
                        Array.isArray(
                          subCategory.criteria
                        )
                          ? subCategory.criteria.map(
                              mergeOptions
                            )
                          : [],
                    })
                  )
                : [],
          };
        }
      } catch (optionsError) {
        console.warn(
          "LOAD SCORE OPTIONS WARNING:",
          optionsError
        );
      }

      setData(
        enrichedResult
      );

      setCategoryDataMap((current) => ({
        ...current,
        [targetCategoryId]: enrichedResult as MainData,
      }));
    } catch (error) {
      console.error(
        "LOAD JUDGE CATEGORY ERROR:",
        error
      );

      setError(
        error instanceof Error
          ? error.message
          : "Gagal mengambil data penilaian."
      );
    } finally {
      setLoading(false);
    }
  }

  /*
   * =======================================================
   * LOAD PARTICIPANTS
   * =======================================================
   */

  async function loadParticipants(
    targetCategoryId = activeCategoryId,
    preserveParticipantId?: string | null
  ) {
    try {
      setParticipantsLoading(
        true
      );

      const response =
        await fetch(
          `/api/judge/category/${encodeURIComponent(
            targetCategoryId
          )}/participants`,
          {
            method: "GET",
            cache: "no-store",
            headers: {
              "Cache-Control":
                "no-cache",
            },
          }
        );

      const result =
        (await response.json()) as
          ParticipantResponse;

      if (!response.ok) {
        throw new Error(
          result.error ||
            "Gagal mengambil peserta."
        );
      }

      const list =
        Array.isArray(
          result.participants
        )
          ? result.participants
          : [];

      const sorted =
        [...list].sort(
          (a, b) => {
            const orderA =
              Number(
                a.displayOrder ||
                  a.number ||
                  0
              );

            const orderB =
              Number(
                b.displayOrder ||
                  b.number ||
                  0
              );

            return (
              orderA -
              orderB
            );
          }
        );

      setParticipants(
        sorted
      );

      /*
       * Saat berpindah kategori dalam workflow yang sama,
       * peserta TIDAK boleh ikut berpindah.
       * Cari kembali peserta yang sama berdasarkan ID.
       */
      if (preserveParticipantId) {
        const preservedIndex = sorted.findIndex(
          (participant) =>
            participant.id === preserveParticipantId
        );

        if (preservedIndex >= 0) {
          setParticipantIndex(preservedIndex);
          setCriterionIndex(0);
          setPositionInitialized(true);
        } else {
          setPositionInitialized(false);
        }
      }
    } catch (error) {
      console.error(
        "LOAD JUDGE PARTICIPANTS ERROR:",
        error
      );

      setError(
        error instanceof Error
          ? error.message
          : "Gagal mengambil peserta."
      );
    } finally {
      setParticipantsLoading(
        false
      );
    }
  }

  /*
   * =======================================================
   * INITIAL LOAD + WORKFLOW CATEGORIES
   * =======================================================
   */

  useEffect(() => {
    if (!categoryId) {
      return;
    }

    let cancelled = false;

    async function initializeWorkflow() {
      try {
        setLoading(true);
        setError("");

        const response = await fetch("/api/judge/me", {
          cache: "no-store",
          headers: {
            "Cache-Control": "no-cache",
          },
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result?.error || "Gagal mengambil penugasan juri."
          );
        }

        const assigned = Array.isArray(result?.categories)
          ? (result.categories as Category[])
          : [];

        const currentCategory = assigned.find(
          (item) => item.id === categoryId
        );

        if (!currentCategory) {
          throw new Error(
            "Kategori ini tidak termasuk dalam penugasan Anda."
          );
        }

        const sameLevel = assigned
          .filter((item) => {
            if (item.eventId !== currentCategory.eventId) {
              return false;
            }

            return (
              (item.eventLevelId || null) ===
              (currentCategory.eventLevelId || null)
            );
          })
          .sort((a, b) => a.sortOrder - b.sortOrder);

        const start = sameLevel.findIndex(
          (item) => item.id === categoryId
        );

        const ordered =
          start >= 0 ? sameLevel.slice(start) : sameLevel;

        if (!ordered.length) {
          throw new Error("Tidak ada kategori penilaian yang ditugaskan.");
        }

        if (cancelled) return;

        setWorkflowCategories(ordered);
        setWorkflowIndex(0);
        setPositionInitialized(false);

        await Promise.all([
          loadMainData(ordered[0].id),
          loadParticipants(ordered[0].id),
        ]);
      } catch (error) {
        if (cancelled) return;

        console.error("LOAD JUDGE WORKFLOW ERROR:", error);
        setError(
          error instanceof Error
            ? error.message
            : "Gagal mengambil penugasan juri."
        );
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    initializeWorkflow();

    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [categoryId]);

  /*
   * =======================================================
   * ALL CRITERIA
   * =======================================================
   */

  const allCriteria =
    useMemo(() => {
      if (!data) {
        return [];
      }

      const result: Criterion[] =
        [];

      /*
       * SUB CATEGORY
       */

      data.subCategories
        .sort(
          (a, b) =>
            a.sortOrder -
            b.sortOrder
        )
        .forEach(
          (subCategory) => {
            const criteria =
              [
                ...subCategory.criteria,
              ].sort(
                (a, b) =>
                  a.sortOrder -
                  b.sortOrder
              );

            result.push(
              ...criteria
            );
          }
        );

      /*
       * DIRECT CATEGORY CRITERIA
       */

      const directCriteria =
        [
          ...data.criteria,
        ].sort(
          (a, b) =>
            a.sortOrder -
            b.sortOrder
        );

      result.push(
        ...directCriteria
      );

      /*
       * REMOVE DUPLICATES
       */

      const unique =
        new Map<
          string,
          Criterion
        >();

      result.forEach(
        (criterion) => {
          unique.set(
            criterion.id,
            criterion
          );
        }
      );

      return Array.from(
        unique.values()
      );
    }, [data]);

  /*
   * =======================================================
   * CURRENT PARTICIPANT
   * =======================================================
   */

  const currentParticipant =
    participants[
      participantIndex
    ] || null;

  /*
   * =======================================================
   * CURRENT CRITERION
   * =======================================================
   */

  const currentCriterion =
    allCriteria[
      criterionIndex
    ] || null;

  /*
   * =======================================================
   * CURRENT KEY
   * =======================================================
   */

  const currentKey =
    currentParticipant &&
    currentCriterion
      ? `${currentParticipant.id}:${currentCriterion.id}`
      : "";

  /*
   * =======================================================
   * CURRENT VALUE
   * =======================================================
   */

  const currentValue =
    currentKey
      ? selectedValues[
          currentKey
        ]
      : undefined;

  /*
   * =======================================================
   * INITIALIZE EXISTING SCORES
   * =======================================================
   */

  useEffect(() => {
    if (
      !data ||
      !Array.isArray(
        data.scores
      )
    ) {
      return;
    }

    setSelectedValues(
      (current) => {
        const next = {
          ...current,
        };

        data.scores.forEach(
          (score) => {
            if (
              score.categoryId &&
              score.categoryId !==
                activeCategoryId
            ) {
              return;
            }

            const key =
              `${score.participantId}:${score.criterionId}`;

            if (
              !next[key]
            ) {
              next[key] = {
                score:
                  Number(
                    score.score
                  ),

                label:
                  score.label ||
                  "",

                note:
                  score.note ||
                  "",
              };
            }
          }
        );

        return next;
      }
    );
  }, [
    data,
    activeCategoryId,
  ]);

  /*
   * =======================================================
   * RESUME POSITION
   * =======================================================
   */

  useEffect(() => {
    if (
      positionInitialized ||
      !data ||
      participants.length === 0 ||
      allCriteria.length === 0
    ) {
      return;
    }

    const scoreKeys =
      new Set(
        data.scores
          .filter(
            (score) =>
              !score.categoryId ||
              score.categoryId ===
                activeCategoryId
          )
          .map(
            (score) =>
              `${score.participantId}:${score.criterionId}`
          )
      );

    let targetParticipant = 0;
    let targetCriterion = 0;
    let foundIncomplete = false;

    for (
      let p = 0;
      p < participants.length;
      p += 1
    ) {
      for (
        let c = 0;
        c < allCriteria.length;
        c += 1
      ) {
        const key =
          `${participants[p].id}:${allCriteria[c].id}`;

        if (
          !scoreKeys.has(key)
        ) {
          targetParticipant =
            p;

          targetCriterion =
            c;

          foundIncomplete =
            true;

          break;
        }
      }

      if (
        foundIncomplete
      ) {
        break;
      }
    }

    if (
      !foundIncomplete
    ) {
      targetParticipant =
        participants.length -
        1;

      targetCriterion =
        allCriteria.length -
        1;
    }

    setParticipantIndex(
      targetParticipant
    );

    setCriterionIndex(
      targetCriterion
    );

    setPositionInitialized(
      true
    );
  }, [
    data,
    participants,
    allCriteria,
    activeCategoryId,
    positionInitialized,
  ]);

  /*
   * =======================================================
   * GO TO PARTICIPANT
   * =======================================================
   */

  function goToParticipant(
    index: number
  ) {
    if (
      index < 0 ||
      index >=
        participants.length
    ) {
      return;
    }

    setParticipantIndex(
      index
    );

    setCriterionIndex(0);

    setSuccessMessage("");
  }

  /*
   * =======================================================
   * PINDAH PESERTA
   * =======================================================
   *
   * Pindah peserta hanya mengubah posisi tampilan juri.
   * Nilai yang sudah tersimpan tetap terkait ke participantId.
   */

  function openParticipantPicker() {
    if (saving || participantActionLoading) {
      return;
    }

    setShowParticipantPicker(true);
  }

  function selectParticipant(index: number) {
    if (participantActionLoading) {
      return;
    }

    goToParticipant(index);
    setShowParticipantPicker(false);
  }

  /*
   * =======================================================
   * TANDAI MENGUNDURKAN DIRI
   * =======================================================
   *
   * Tidak menghapus nilai / data peserta.
   * Hanya mengubah status peserta menjadi INACTIVE melalui API.
   */

  async function withdrawCurrentParticipant() {
    if (!currentParticipant || participantActionLoading) {
      return;
    }

    try {
      setParticipantActionLoading(true);
      setError("");

      const response = await fetch("/api/judge/participant", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        credentials: "include",
        body: JSON.stringify({
          participantId: currentParticipant.id,
          categoryId: activeCategoryId,
          action: "WITHDRAW",
          reason: withdrawReason.trim() || null,
        }),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          result?.error ||
            "Gagal menandai peserta mengundurkan diri."
        );
      }

      const removedIndex = participantIndex;

      setParticipants((current) =>
        current.filter((participant) =>
          participant.id !== currentParticipant.id
        )
      );

      setShowWithdrawConfirm(false);
      setWithdrawReason("");
      setSuccessMessage("Peserta ditandai mengundurkan diri.");
      setCriterionIndex(0);

      setParticipantIndex((currentIndex) => {
        const nextLength = participants.length - 1;

        if (nextLength <= 0) {
          return 0;
        }

        return Math.min(removedIndex, nextLength - 1);
      });
    } catch (error) {
      console.error("WITHDRAW PARTICIPANT ERROR:", error);

      setError(
        error instanceof Error
          ? error.message
          : "Gagal menandai peserta mengundurkan diri."
      );
    } finally {
      setParticipantActionLoading(false);
    }
  }

  /*
   * =======================================================
   * PINDAH MATERI
   * =======================================================
   *
   * Hanya mengubah posisi materi. Nilai tetap aman karena
   * penyimpanan score menggunakan participantId:criterionId.
   */

  function openCriterionPicker() {
    if (saving || participantActionLoading) {
      return;
    }

    setShowCriterionPicker(true);
  }

  function selectCriterion(index: number) {
    if (saving || participantActionLoading) {
      return;
    }

    if (index < 0 || index >= allCriteria.length) {
      return;
    }

    setCriterionIndex(index);
    setSuccessMessage("");
    setShowCriterionPicker(false);
  }

  /*
   * =======================================================
   * GO TO CRITERION
   * =======================================================
   */

  function goToCriterion(
    index: number
  ) {
    if (
      index < 0 ||
      index >=
        allCriteria.length
    ) {
      return;
    }

    setCriterionIndex(
      index
    );

    setSuccessMessage("");
  }

  /*
   * =======================================================
   * SELECT OPTION
   * =======================================================
   */

  async function selectOption(
    option: Option
  ) {
    if (
      !currentParticipant ||
      !currentCriterion ||
      saving
    ) {
      return;
    }

    const key =
      `${currentParticipant.id}:${currentCriterion.id}`;

    /*
     * Update UI terlebih dahulu.
     */

    setSelectedValues(
      (current) => ({
        ...current,

        [key]: {
          score:
            getJudgeScore(Number(option.score)),

          label:
            option.label,

          note:
            current[key]
              ?.note || "",
        },
      })
    );

    /*
     * Simpan ke server.
     */

    await saveCurrentScore(
      option
    );
  }

  /*
   * =======================================================
   * SAVE CURRENT SCORE
   * =======================================================
   */

  async function saveCurrentScore(
    option: Option
  ) {
    if (
      !currentParticipant ||
      !currentCriterion
    ) {
      return;
    }

    try {
      setSaving(true);

      setError("");

      setSuccessMessage("");

      const response =
        await fetch(
          `/api/judge/category/${encodeURIComponent(
            activeCategoryId
          )}`,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body: JSON.stringify({
              participantId:
                currentParticipant.id,

              criterionId:
                currentCriterion.id,

              categoryId:
                activeCategoryId,

              score:
                getJudgeScore(Number(option.score)),

              label:
                option.label,

              note:
                selectedValues[
                  `${currentParticipant.id}:${currentCriterion.id}`
                ]?.note || null,
            }),
          }
        );

      const result =
        await response.json();

      if (!response.ok) {
        throw new Error(
          result.error ||
            "Gagal menyimpan nilai."
        );
      }

      /*
       * Update score lokal.
       */

      setData(
        (current) => {
          if (!current) {
            return current;
          }

          const savedScore =
            result.score ||
            result;

          const scoreObject: Score =
            {
              id:
                savedScore.id ||
                `${currentParticipant.id}-${currentCriterion.id}`,

              participantId:
                currentParticipant.id,

              criterionId:
                currentCriterion.id,

              categoryId:
                activeCategoryId,

              score:
                getJudgeScore(Number(option.score)),

              label:
                option.label,

              note:
                selectedValues[
                  `${currentParticipant.id}:${currentCriterion.id}`
                ]?.note ||
                null,

              status:
                savedScore.status ||
                "DRAFT",
            };

          const index =
            current.scores.findIndex(
              (score) =>
                score.participantId ===
                  currentParticipant.id &&
                score.criterionId ===
                  currentCriterion.id
            );

          if (
            index === -1
          ) {
            return {
              ...current,

              scores: [
                ...current.scores,
                scoreObject,
              ],
            };
          }

          const nextScores = [
            ...current.scores,
          ];

          nextScores[index] =
            scoreObject;

          return {
            ...current,

            scores:
              nextScores,
          };
        }
      );

      setSuccessMessage(
        `Nilai ${formatNumber(
          getJudgeScore(Number(option.score))
        )} tersimpan`
      );

      /*
       * ===================================================
       * AUTO NEXT
       * ===================================================
       */

      setTimeout(() => {
        /*
         * MASIH ADA MATERI
         */

        if (
          criterionIndex <
          allCriteria.length - 1
        ) {
          setCriterionIndex(
            (current) =>
              current + 1
          );

          setSuccessMessage("");

          return;
        }

        /*
         * MATERI TERAKHIR → KATEGORI BERIKUTNYA
         *
         * Peserta TIDAK berubah. Peserta yang sama harus
         * menyelesaikan PBB, KOMANDAN, dst sesuai penugasan.
         */
        const nextCategoryIndex = workflowIndex + 1;

        if (nextCategoryIndex < workflowCategories.length) {
          const nextCategory = workflowCategories[nextCategoryIndex];

          setSuccessMessage(
            `Selesai ${data?.category.name || "kategori ini"}. Lanjut ${nextCategory.name}...`
          );

          setLoading(true);
          setPositionInitialized(false);

          const preserveParticipantId =
            currentParticipant?.id || null;

          Promise.all([
            loadMainData(nextCategory.id),
            loadParticipants(
              nextCategory.id,
              preserveParticipantId
            ),
          ])
            .then(() => {
              setWorkflowIndex(nextCategoryIndex);
              setCriterionIndex(0);
              setSuccessMessage("");
            })
            .catch((nextError) => {
              console.error("LOAD NEXT JUDGE CATEGORY ERROR:", nextError);
              setError(
                nextError instanceof Error
                  ? nextError.message
                  : "Gagal membuka kategori berikutnya."
              );
            })
            .finally(() => {
              setLoading(false);
            });

          return;
        }

        /*
         * KATEGORI TERAKHIR SELESAI → REVIEW PESERTA
         */
        setSuccessMessage("Semua kategori peserta ini sudah dinilai. Membuka review...");
        setShowReview(true);
      }, 350);
    } catch (error) {
      console.error(
        "SAVE JUDGE SCORE ERROR:",
        error
      );

      setError(
        error instanceof Error
          ? error.message
          : "Gagal menyimpan nilai."
      );
    } finally {
      setSaving(false);
    }
  }

  /*
   * =======================================================
   * COMPLETED COUNT
   * =======================================================
   */

  const workflowCriteria = useMemo(() => {
    const result: Array<{
      categoryId: string;
      categoryName: string;
      criteria: Criterion[];
    }> = [];

    for (const category of workflowCategories) {
      const categoryData = categoryDataMap[category.id];
      if (!categoryData) continue;

      const criteria: Criterion[] = [];

      [...categoryData.subCategories]
        .sort((a, b) => a.sortOrder - b.sortOrder)
        .forEach((subCategory) => {
          criteria.push(
            ...[...subCategory.criteria].sort(
              (a, b) => a.sortOrder - b.sortOrder
            )
          );
        });

      criteria.push(
        ...[...categoryData.criteria].sort(
          (a, b) => a.sortOrder - b.sortOrder
        )
      );

      const unique = Array.from(
        new Map(criteria.map((criterion) => [criterion.id, criterion])).values()
      );

      result.push({
        categoryId: category.id,
        categoryName: category.name,
        criteria: unique,
      });
    }

    return result;
  }, [workflowCategories, categoryDataMap]);

  const totalWorkflowCriteria = workflowCriteria.reduce(
    (sum, group) => sum + group.criteria.length,
    0
  );

  const completedWorkflowCriteria = currentParticipant
    ? workflowCriteria.reduce(
        (sum, group) =>
          sum +
          group.criteria.filter((criterion) =>
            Boolean(
              selectedValues[`${currentParticipant.id}:${criterion.id}`]
            )
          ).length,
        0
      )
    : 0;

  const completedCriteria =
    currentParticipant
      ? allCriteria.filter(
          (criterion) => {
            const key =
              `${currentParticipant.id}:${criterion.id}`;

            return Boolean(
              selectedValues[key]
            );
          }
        ).length
      : 0;

  const currentParticipantSubmitted =
    currentParticipant &&
    data &&
    allCriteria.length > 0
      ? allCriteria.every((criterion) => {
          const score = data.scores.find(
            (item) =>
              item.participantId === currentParticipant.id &&
              item.criterionId === criterion.id
          );

          return score?.status === "SUBMITTED" ||
            score?.status === "LOCKED";
        })
      : false;

  /*
   * Status submit khusus kategori yang sedang dibuka.
   * Dipakai hanya untuk tombol REQUEST_CHANGE.
   */
  const currentCategorySubmitted =
    currentParticipant &&
    data &&
    allCriteria.length > 0
      ? allCriteria.every((criterion) => {
          const score = data.scores.find(
            (item) =>
              item.participantId === currentParticipant.id &&
              item.criterionId === criterion.id
          );

          return score?.status === "SUBMITTED" ||
            score?.status === "LOCKED";
        })
      : false;

