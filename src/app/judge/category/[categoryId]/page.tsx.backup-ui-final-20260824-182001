   */

  /*
   * =======================================================
   * REQUEST PERUBAHAN NILAI KE ADMIN
   * =======================================================
   */

  async function requestScoreChange() {
    if (
      !currentParticipant ||
      changeRequestLoading ||
      changeRequestPending
    ) {
      return;
    }

    const reason = changeReason.trim();

    if (reason.length < 5) {
      setError(
        "Alasan perubahan minimal 5 karakter."
      );
      return;
    }

    try {
      setChangeRequestLoading(true);
      setError("");
      setSuccessMessage("");

      const response = await fetch(
        `/api/judge/category/${encodeURIComponent(activeCategoryId)}`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            action: "REQUEST_CHANGE",
            participantId: currentParticipant.id,
            categoryId: activeCategoryId,
            reason,
          }),
        }
      );

      const result = await response.json();

      if (!response.ok) {
        if (
          result?.code ===
          "SCORE_CHANGE_REQUEST_PENDING"
        ) {
          setChangeRequestPending(true);
        }

        throw new Error(
          result?.error ||
            "Gagal mengirim permintaan perubahan nilai."
        );
      }

      setChangeRequestPending(true);
      setShowChangeRequest(false);
      setChangeReason("");

      setSuccessMessage(
        "Permintaan perubahan nilai berhasil dikirim kepada Admin."
      );
    } catch (error) {
      console.error(
        "REQUEST SCORE CHANGE ERROR:",
        error
      );

      setError(
        error instanceof Error
          ? error.message
          : "Gagal mengirim permintaan perubahan nilai."
      );
    } finally {
      setChangeRequestLoading(false);
    }
  }
  async function submitCurrentParticipant() {
    if (
      !currentParticipant ||
      submitting ||
      saving
    ) {
      return;
    }

    if (
      totalWorkflowCriteria === 0 ||
      completedWorkflowCriteria !== totalWorkflowCriteria
    ) {
      setError(
        `Nilai belum lengkap. ${completedWorkflowCriteria} dari ${totalWorkflowCriteria} materi sudah dinilai.`
      );
      return;
    }

    try {
      setSubmitting(true);
      setError("");
      setSuccessMessage("");

      const submittedAt = new Date().toISOString();

      for (const group of workflowCriteria) {
        const response = await fetch(
          `/api/judge/category/${encodeURIComponent(group.categoryId)}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              action: "SUBMIT",
              participantId: currentParticipant.id,
              categoryId: group.categoryId,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error ||
              `Gagal submit kategori ${group.categoryName}.`
          );
        }

        const categorySubmittedAt =
          result.submittedAt || submittedAt;

        setCategoryDataMap((current) => {
          const existing = current[group.categoryId];
          if (!existing) return current;

          return {
            ...current,
            [group.categoryId]: {
              ...existing,
              scores: existing.scores.map((score) =>
                score.participantId === currentParticipant.id
                  ? {
                      ...score,
                      status: "SUBMITTED",
                      submittedAt: categorySubmittedAt,
                    }
                  : score
              ),
            },
          };
        });
      }

      setData((current) => {
        if (!current) return current;

        return {
          ...current,
          scores: current.scores.map((score) =>
            score.participantId === currentParticipant.id
              ? {
                  ...score,
                  status: "SUBMITTED",
                  submittedAt,
                }
              : score
          ),
        };
      });

      setShowReview(false);
      setSuccessMessage("Nilai peserta berhasil disubmit.");

      setTimeout(async () => {
        if (participantIndex < participants.length - 1) {
          const nextParticipantIndex = participantIndex + 1;
          const firstCategory = workflowCategories[0];

          if (!firstCategory) {
            setSuccessMessage(
              "Semua peserta pada tingkatan ini sudah dinilai dan disubmit."
            );
            return;
          }

          try {
            setLoading(true);
            setError("");

            /*
             * Peserta berikutnya selalu dimulai dari kategori
             * pertama pada tingkatan tersebut (mis. PBB →
             * KOMANDAN untuk peserta yang sama, lalu peserta
             * berikutnya kembali mulai dari PBB).
             */
            setWorkflowIndex(0);
            setParticipantIndex(nextParticipantIndex);
            setCriterionIndex(0);
            setShowReview(false);
            setPositionInitialized(true);

            const firstCategoryData =
              categoryDataMap[firstCategory.id];

            if (firstCategoryData) {
              setData(firstCategoryData);
            } else {
              await loadMainData(firstCategory.id);
            }

            setSuccessMessage("");
            window.scrollTo({
              top: 0,
              behavior: "smooth",
            });
          } catch (nextParticipantError) {
            console.error(
              "LOAD NEXT PARTICIPANT WORKFLOW ERROR:",
              nextParticipantError
            );

            setError(
              nextParticipantError instanceof Error
                ? nextParticipantError.message
                : "Gagal membuka peserta berikutnya."
            );
          } finally {
            setLoading(false);
          }

          return;
        }

        setSuccessMessage(
          "Semua peserta pada tingkatan ini sudah dinilai dan disubmit."
        );
      }, 350);
    } catch (error) {
      console.error("SUBMIT JUDGE WORKFLOW ERROR:", error);
      setError(
        error instanceof Error
          ? error.message
          : "Gagal submit nilai peserta."
      );
    } finally {
      setSubmitting(false);
    }
  }

